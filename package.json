{
	"name": "nhrrob-core-contributions",
	"version": "2.0.0",
	"description": "Blocks and settings screen for NHR Core Contributions.",
	"author": "Nazmul Hasan Robin <robin.sust08@gmail.com>",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"dev": "npm-run-all --parallel blocks:dev dashboard:dev",
		"build": "npm-run-all blocks:build dashboard:build",
		"blocks:dev": "wp-scripts start --webpack-src-dir=assets/blocks/src --output-path=assets/blocks/build",
		"blocks:build": "wp-scripts build --webpack-src-dir=assets/blocks/src --output-path=assets/blocks/build",
		"dashboard:dev": "wp-scripts start --webpack-src-dir=assets/dashboard/src --output-path=assets/dashboard/build",
		"dashboard:build": "wp-scripts build --webpack-src-dir=assets/dashboard/src --output-path=assets/dashboard/build",
		"lint:js": "wp-scripts lint-js assets/blocks/src assets/dashboard/src",
		"lint": "wp-scripts lint-js assets/blocks/src assets/dashboard/src",
		"prepare": "git config core.hooksPath .husky || true"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.10.0",
		"npm-run-all": "^4.1.5",
		"typescript": "~6.0.3"
	}
}
