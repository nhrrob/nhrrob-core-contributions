{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nhrcc-core-contributions/contribution-stats",
  "version": "2.0.0",
  "title": "Contribution Stats",
  "category": "widgets",
  "icon": "chart-bar",
  "description": "The headline contribution numbers of a WordPress.org username.",
  "keywords": [
    "contributions",
    "stats",
    "numbers"
  ],
  "textdomain": "nhrrob-core-contributions",
  "attributes": {
    "username": {
      "type": "string",
      "default": ""
    },
    "accentColor": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "gradients": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true
    }
  },
  "editorScript": "nhrcc-blocks-editor",
  "style": "nhrcc-blocks"
}