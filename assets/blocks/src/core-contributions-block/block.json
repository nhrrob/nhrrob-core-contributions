{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nhrcc-core-contributions/core-contributions-block",
	"version": "2.0.0",
	"title": "NHR Core Contributions",
	"category": "widgets",
	"icon": "list-view",
	"description": "A paginated list of the WordPress core or Gutenberg contributions of a WordPress.org username.",
	"keywords": [
		"contributions",
		"core",
		"gutenberg",
		"props"
	],
	"textdomain": "nhrrob-core-contributions",
	"attributes": {
		"username": {
			"type": "string",
			"default": ""
		},
		"accentColor": {
			"type": "string",
			"default": ""
		},
		"source": {
			"type": "string",
			"default": "core",
			"enum": [
				"core",
				"gutenberg"
			]
		},
		"showHeader": {
			"type": "boolean",
			"default": true
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showPagination": {
			"type": "boolean",
			"default": true
		},
		"preset": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true
		}
	},
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "minimal",
			"label": "Minimal"
		},
		{
			"name": "timeline",
			"label": "Timeline"
		}
	],
	"editorScript": "nhrcc-blocks-editor",
	"style": "nhrcc-blocks"
}
