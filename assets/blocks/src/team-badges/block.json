{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nhrcc-core-contributions/team-badges",
	"version": "2.0.0",
	"title": "WordPress.org Badges",
	"category": "nhrcc",
	"icon": "groups",
	"description": "The WordPress.org profile badges of a username: teams, WordCamps, translation and more.",
	"keywords": [
		"nhr",
		"contributor",
		"contributions",
		"badges",
		"teams",
		"polyglots",
		"wordcamp",
		"docs"
	],
	"textdomain": "nhrrob-core-contributions",
	"attributes": {
		"username": {
			"type": "string",
			"default": ""
		},
		"accentColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": true,
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true
		}
	},
	"editorScript": "nhrcc-blocks-editor",
	"style": "nhrcc-blocks"
}
